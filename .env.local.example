# Supabase proje URL'i (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public, client tarafinda kullanilabilir)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (GIZLI - sadece server tarafinda, client bundle'a girmemeli)
SUPABASE_SERVICE_ROLE_KEY=

# Hardcover.app API tokeni (2. kaynak — opsiyonel ama önerilir)
# https://hardcover.app/account/api adresinden ücretsiz alınır
HARDCOVER_API_TOKEN=

# Google Books API key (3. kaynak — opsiyonel ama önerilir)
# Google Cloud Console > Books API'yi etkinleştir > Credentials > Create API key
GOOGLE_BOOKS_API_KEY=
