# Supabase proje URL'i (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (public, client tarafinda kullanilabilir)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (GIZLI - sadece server tarafinda, client bundle'a girmemeli)
SUPABASE_SERVICE_ROLE_KEY=

# Google Books API key (opsiyonel - bos birakilirsa public endpoint denenir)
GOOGLE_BOOKS_API_KEY=
